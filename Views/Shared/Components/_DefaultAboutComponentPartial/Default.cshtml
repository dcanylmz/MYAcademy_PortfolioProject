@model About?
@if (Model != null)
{
    var paragraphs = (Model.AboutContent ?? string.Empty)
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    <section id="about" class="bg-white border-top border-bottom">
        <div class="container">
            <div class="row align-items-center gy-5">
                <div class="col-lg-5 reveal-on-scroll">
                    <div class="about-img-wrap">
                        @if (!string.IsNullOrEmpty(Model.AboutMainImageUrl))
                        {
                            <img src="@Model.AboutMainImageUrl" alt="@Model.AboutNameSurname portre" class="w-100" style="height: 540px; object-fit: cover; object-position: center top;">
                        }
                        else
                        {
                            <div class="w-100 d-flex align-items-center justify-content-center bg-light" style="height: 540px;"><i class="bi bi-person fs-1 text-muted"></i></div>
                        }
                        <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                            <span class="small text-muted font-heading">@Model.AboutNameSurname, @Model.AboutLocation</span>
                            <span class="badge bg-secondary-subtle text-dark fw-medium">@Model.AboutProfession</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                    <div class="eyebrow-badge">
                        <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                    </div>
                    <h2 class="section-title">@Model.AboutTitle</h2>
                    <div class="text-muted fs-5 mb-4 lh-base">
                        @foreach (var paragraph in paragraphs)
                        {
                            <p class="mb-3">@paragraph</p>
                        }
                    </div>

                    <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                        <div class="col-4">
                            <div class="stat-number">@Model.AboutExperienceValue</div>
                            <div class="stat-label">@Model.AboutExperienceTitle</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.AboutCVUrl))
                        {
                            <a href="@Model.AboutCVUrl" target="_blank" rel="noopener noreferrer" class="btn-sage">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <span>Özgeçmişimi İncele</span>
                            </a>
                        }
                        <a href="#contact" class="btn-secondary-custom">
                            <span>Bana Ulaşın</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
