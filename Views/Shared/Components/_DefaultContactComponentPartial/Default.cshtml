@model Contact?
<section id="contact">
    <div class="container">
        <div class="row gy-5">
            <div class="col-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-envelope-paper-fill"></i> İLETİŞİME GEÇELİM
                </div>
                <h2 class="section-title">@(Model?.Title ?? "İletişime Geçin")</h2>
                @if (!string.IsNullOrWhiteSpace(Model?.Description))
                {
                    <p class="text-muted mb-4 fs-6">@Model!.Description</p>
                }

                @if (Model != null)
                {
                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                            <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);"><i class="bi bi-envelope"></i></div>
                            <div>
                                <div class="text-muted small">E-posta</div>
                                <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none text-reset">@Model.Email</a>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                                <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);"><i class="bi bi-telephone"></i></div>
                                <div>
                                    <div class="text-muted small">Telefon</div>
                                    <div class="fw-semibold">@Model.PhoneNumber</div>
                                </div>
                            </div>
                        }
                        <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                            <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);"><i class="bi bi-geo-alt"></i></div>
                            <div>
                                <div class="text-muted small">Konum</div>
                                <div class="fw-semibold">@Model.Location</div>
                            </div>
                        </div>
                    </div>
                }

                <div class="pt-2">
                    <div class="text-muted small font-heading fw-semibold mb-2">Sosyal Ağlar:</div>
                    <div class="d-flex gap-2">
                        @await Component.InvokeAsync("_DefaultSocialLinksComponentPartial", new { style = "pill" })
                    </div>
                </div>
            </div>

            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                    <partial name="_ContactForm" />
                </div>
            </div>
        </div>
    </div>
</section>
