@model Social
@{
    ViewData["Title"] = "Bağlantıyı Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<partial name="_AdminFormStyles" />

<div class="af container-fluid py-3">
    <div class="row">
        <div class="col-xl-6 col-lg-8">
            <div class="af-card">
                <div class="af-head">
                    <div class="af-icon"><i class="bi bi-share"></i></div>
                    <div><h4>Bağlantıyı Güncelle</h4><small>#@Model.SocialID numaralı bağlantıyı düzenleyin.</small></div>
                </div>
                <form asp-action="UpdateSocial" method="post">
                    <input type="hidden" asp-for="SocialID" />
                    <div class="mb-3">
                        <label asp-for="SocialPlatform" class="form-label">Platform</label>
                        <input asp-for="SocialPlatform" class="form-control" />
                        <span asp-validation-for="SocialPlatform" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SocialURL" class="form-label">Bağlantı</label>
                        <input asp-for="SocialURL" class="form-control" />
                        <span asp-validation-for="SocialURL" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="SocialIcon" class="form-label">İkon (Bootstrap Icons)</label>
                        <input asp-for="SocialIcon" class="form-control" placeholder="bi-github" />
                        <span asp-validation-for="SocialIcon" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="af-btn">Değişiklikleri Kaydet</button>
                        <a asp-action="SocialList" class="af-btn-light">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
