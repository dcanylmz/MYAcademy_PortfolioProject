@model About?
@{
    ViewData["Title"] = "Hakkımda";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<partial name="_AdminFormStyles" />
<partial name="_AdminSummaryStyles" />

<div class="af container-fluid py-3">
    <div class="af-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="af-head mb-0">
                <div class="af-icon"><i class="bi bi-person"></i></div>
                <div>
                    <h4>Hakkımda</h4>
                    <small>Sitedeki "Beni Tanıyın" bölümünü besler.</small>
                </div>
            </div>
            <a asp-action="UpdateAbout" class="af-btn"><i class="bi bi-pencil me-1"></i> @(Model == null ? "Bilgileri Ekle" : "Düzenle")</a>
        </div>

        @if (Model == null)
        {
            <div class="af-empty">Henüz hakkımda bilgisi girilmedi.</div>
        }
        else
        {
            <div class="mb-4">
                @if (!string.IsNullOrEmpty(Model.AboutMainImageUrl))
                {
                    <img src="@Model.AboutMainImageUrl" alt="Profil görseli" class="af-thumb" style="width:96px;height:96px;" />
                }
            </div>
            <dl class="af-kv">
                <dt>Ad Soyad</dt><dd>@Model.AboutNameSurname</dd>
                <dt>Meslek / Unvan</dt><dd>@Model.AboutProfession</dd>
                <dt>Konum</dt><dd>@Model.AboutLocation</dd>
                <dt>Başlık</dt><dd>@Model.AboutTitle</dd>
                <dt>Metin</dt><dd>@Model.AboutContent</dd>
                <dt>Öne Çıkan Bilgi</dt><dd>@Model.AboutExperienceValue @Model.AboutExperienceTitle</dd>
                <dt>Özgeçmiş Bağlantısı</dt><dd>@(string.IsNullOrWhiteSpace(Model.AboutCVUrl) ? "-" : Model.AboutCVUrl)</dd>
            </dl>
        }
    </div>
</div>

<partial name="_AdminAlerts" />
