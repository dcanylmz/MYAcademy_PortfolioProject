﻿
@model About

@{
    ViewData["Title"] = "Hakkımda Bilgisi Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="content-header-row">
    <div>
        <h2 class="page-title">Hakkımda Bilgisi Ekle</h2>
        <p class="page-subtitle">
            Profil bilgilerinizi ve hakkımda bölümünüzün içeriğini oluşturun.
        </p>
    </div>

    <a href="/Admin/About/Index" class="btn-table-util">
        <i class="bi bi-arrow-left"></i>
        Listeye Dön
    </a>
</div>

<form method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- Kişisel Bilgiler -->
    <div class="data-table-card mb-4">
        <div class="p-4">
            <h5 class="mb-1">Kişisel Bilgiler</h5>
            <p class="text-muted mb-4">
                Profilinizde gösterilecek temel bilgileri giriniz.
            </p>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AboutNameSurname" class="form-label">Ad Soyad</label>
                    <input asp-for="AboutNameSurname" class="form-control"
                           placeholder="Ad soyad giriniz" />
                    <span asp-validation-for="AboutNameSurname" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AboutProfession" class="form-label">Meslek</label>
                    <input asp-for="AboutProfession" class="form-control"
                           placeholder="Örn: Senior Developer" />
                    <span asp-validation-for="AboutProfession" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AboutLocation" class="form-label">Konum</label>
                    <input asp-for="AboutLocation" class="form-control"
                           placeholder="Örn: İstanbul" />
                    <span asp-validation-for="AboutLocation" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AboutTitle" class="form-label">Başlık</label>
                    <input asp-for="AboutTitle" class="form-control"
                           placeholder="Hakkımda başlığı" />
                    <span asp-validation-for="AboutTitle" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Profil İçeriği -->
    <div class="data-table-card mb-4">
        <div class="p-4">
            <h5 class="mb-1">Profil İçeriği</h5>
            <p class="text-muted mb-4">
                Hakkınızda bölümünde görüntülenecek açıklamayı ve profil görselini ekleyiniz.
            </p>

            <div class="mb-3">
                <label asp-for="AboutContent" class="form-label">Açıklama</label>
                <textarea asp-for="AboutContent" class="form-control" rows="5"
                          placeholder="Hakkımda açıklamasını giriniz"></textarea>
                <span asp-validation-for="AboutContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AboutMainImageUrl" class="form-label">Profil Görseli URL</label>
                <input asp-for="AboutMainImageUrl" class="form-control"
                       placeholder="Görsel adresini giriniz" />
                <span asp-validation-for="AboutMainImageUrl" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Bağlantılar -->
    <div class="data-table-card mb-4">
        <div class="p-4">
            <h5 class="mb-1">Bağlantılar</h5>
            <p class="text-muted mb-4">
                CV dosyanızın bağlantısını ekleyebilirsiniz.
            </p>

            <div class="mb-3">
                <label asp-for="AboutCVUrl" class="form-label">CV URL</label>
                <input asp-for="AboutCVUrl" class="form-control"
                       placeholder="CV dosya adresini giriniz" />
                <span asp-validation-for="AboutCVUrl" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- İstatistik Bilgileri -->
    <div class="data-table-card mb-4">
        <div class="p-4">
            <h5 class="mb-1">İstatistik Bilgileri</h5>
            <p class="text-muted mb-4">
                Profilinizde öne çıkarmak istediğiniz üç istatistiği tanımlayınız.
            </p>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="AboutExperienceValue" class="form-label">
                        1. İstatistik Değeri
                    </label>
                    <input asp-for="AboutExperienceValue" class="form-control"
                           placeholder="Örn: 10+" />
                    <span asp-validation-for="AboutExperienceValue" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AboutExperienceTitle" class="form-label">
                        1. İstatistik Başlığı
                    </label>
                    <input asp-for="AboutExperienceTitle" class="form-control"
                           placeholder="Örn: Yıl Deneyim" />
                    <span asp-validation-for="AboutExperienceTitle" class="text-danger"></span>
                </div>

                

            </div>
        </div>
    </div>

    <!-- Form İşlemleri -->
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a href="/Admin/About/Index" class="btn-table-util">
            İptal
        </a>

        <button type="submit" class="btn-pastel-primary">
            <i class="bi bi-check-lg"></i>
            Kaydet
        </button>
    </div>

</form>