@model List<Experience>
@{
    ViewData["Title"] = "Deneyimlerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<partial name="_AdminFormStyles" />

<div class="af container-fluid py-3">
    <div class="af-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="af-head mb-0">
                <div class="af-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
                <div>
                    <h4>Deneyimlerim</h4>
                    <small>@Model.Count deneyim listeleniyor. Pasif deneyimler yönetilebilir ama sitede gösterilmesi için aktif olmalıdır.</small>
                </div>
            </div>
            <a asp-action="CreateExperience" class="af-btn"><i class="bi bi-plus-lg me-1"></i> Yeni Deneyim</a>
        </div>

        <div class="table-responsive">
            <table class="table af-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Pozisyon</th>
                        <th>Şirket</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td>@item.CompanyName</td>
                            <td>@item.CategoryName</td>
                            <td>
                                <form asp-action="ToggleExperienceStatus" asp-route-id="@item.ExperienceID" method="post" class="d-inline">
                                    <button type="submit" class="af-badge @(item.IsActive ? "on" : "off")" title="Durumu değiştir">@(item.IsActive ? "Aktif" : "Pasif")</button>
                                </form>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="UpdateExperience" asp-route-id="@item.ExperienceID" class="af-icon-btn" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DeleteExperience" asp-route-id="@item.ExperienceID" method="post" class="d-inline">
                                    <button type="button" class="af-icon-btn danger js-delete" data-name="@item.Title" title="Sil"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-5">Henüz deneyim eklenmedi.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_AdminAlerts" />
