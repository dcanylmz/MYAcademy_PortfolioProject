@model Experience
<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="af-card">
            <div class="af-head">
                <div class="af-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
                <div>
                    <h4>@ViewData["FormTitle"]</h4>
                    <small>@ViewData["FormSubtitle"]</small>
                </div>
            </div>

            <form asp-action="@(ViewData["FormAction"] as string)" method="post">
                <input type="hidden" asp-for="ExperienceID" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Pozisyon / Başlık</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyName" class="form-label">Şirket / Kurum</label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryName" class="form-label">Kategori</label>
                        <input asp-for="CategoryName" class="form-control" placeholder="Yazılım, Eğitim, Test..." />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Durum</label>
                    <div class="af-switch form-check form-switch m-0">
                        <span id="statusText">@(Model.IsActive ? "Aktif" : "Pasif")</span>
                        <input asp-for="IsActive" class="form-check-input m-0" role="switch" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="af-btn">@ViewData["SubmitText"]</button>
                    <a asp-action="ExperienceList" class="af-btn-light">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.querySelector('.af-switch input').addEventListener('change', function () {
        document.getElementById('statusText').textContent = this.checked ? 'Aktif' : 'Pasif';
    });
</script>
