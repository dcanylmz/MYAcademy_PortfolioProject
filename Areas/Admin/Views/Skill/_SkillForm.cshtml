@model Skill
@* CreateSkill ve UpdateSkill aynı formu kullanır. ViewData: FormAction, FormTitle, FormSubtitle, SubmitText *@
<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="af-card">
            <div class="af-head">
                <div class="af-icon"><i class="bi bi-stars"></i></div>
                <div>
                    <h4>@ViewData["FormTitle"]</h4>
                    <small>@ViewData["FormSubtitle"]</small>
                </div>
            </div>

            <form asp-action="@(ViewData["FormAction"] as string)" method="post">
                <input type="hidden" asp-for="SkillID" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Yetenek Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="ASP.NET Core" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SkillLevel" class="form-label">Seviye: <strong id="levelText">@Model.SkillLevel</strong>/100</label>
                    <input asp-for="SkillLevel" type="range" min="0" max="100" step="5" class="form-range" id="levelRange" />
                    <span asp-validation-for="SkillLevel" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Açıklama (isteğe bağlı)</label>
                    <textarea asp-for="Description" class="form-control" style="min-height:100px"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="IconURL" class="form-label">İkon (isteğe bağlı)</label>
                    <input asp-for="IconURL" class="form-control" placeholder="bi-code-slash" />
                    <span asp-validation-for="IconURL" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="af-btn">@ViewData["SubmitText"]</button>
                    <a asp-action="SkillList" class="af-btn-light">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('levelRange').addEventListener('input', function () {
        document.getElementById('levelText').textContent = this.value;
    });
</script>
