@model List<Education>
@{
    ViewData["Title"] = "Eğitim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<partial name="_AdminFormStyles" />

<div class="af container-fluid py-3">
    <div class="af-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="af-head mb-0">
                <div class="af-icon"><i class="bi bi-mortarboard"></i></div>
                <div>
                    <h4>Eğitim</h4>
                    <small>@Model.Count eğitim kaydı listeleniyor.</small>
                </div>
            </div>
            <a asp-action="CreateEducation" class="af-btn"><i class="bi bi-plus-lg me-1"></i> Yeni Eğitim</a>
        </div>

        <div class="table-responsive">
            <table class="table af-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Okul / Bölüm</th>
                        <th>Yıllar</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.SchoolName</div>
                                <div class="small text-muted">@item.Department</div>
                            </td>
                            <td class="text-nowrap">
                                @item.StartYear - @(item.EndYear?.ToString() ?? "Devam ediyor")
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="UpdateEducation" asp-route-id="@item.EducationID" class="af-icon-btn" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DeleteEducation" asp-route-id="@item.EducationID" method="post" class="d-inline">
                                    <button type="button" class="af-icon-btn danger js-delete" data-name="@item.SchoolName" title="Sil"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-5">Henüz eğitim kaydı eklenmedi.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_AdminAlerts" />
