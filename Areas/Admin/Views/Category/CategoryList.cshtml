@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<partial name="_AdminFormStyles" />

<div class="af container-fluid py-3">
    <div class="af-card">
        <div class="af-head">
            <div class="af-icon"><i class="bi bi-tags"></i></div>
            <div>
                <h4>Proje Kategorileri</h4>
                <small>Projeler bu kategorilere göre gruplanır ve filtrelenir.</small>
            </div>
        </div>

        <form asp-action="CreateCategory" method="post" class="row g-2 mb-4">
            <div class="col-md-8">
                <input name="CategoryName" class="form-control" placeholder="Yeni kategori adı (ör. Web, Mobil, Masaüstü)" maxlength="50" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="af-btn w-100"><i class="bi bi-plus-lg me-1"></i> Kategori Ekle</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table af-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:70px">#</th>
                        <th>Kategori</th>
                        <th>Proje Sayısı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryId</td>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td>@item.Projects.Count</td>
                            <td class="text-end">
                                <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId" class="af-icon-btn" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteCategory" asp-route-id="@item.CategoryId" method="post" class="d-inline">
                                    @if (item.Projects.Count > 0)
                                    {
                                        <button type="button" class="af-icon-btn danger" disabled title="Bu kategoride proje var, silinemez">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="af-icon-btn danger js-delete" data-name="@item.CategoryName" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">Henüz kategori yok. Yukarıdan ilk kategoriyi ekleyin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_AdminAlerts" />
