@model List<MYAcademy_PortfolioProject.Entities.Message>
@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container">
    <br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Gonderen</th>
            <th>Konu</th>
            <th>Tarih</th>
            <th>Mesaji Ac</th>
            <th>Mesaji Duzenle</th>
            <th>Mesaji Sil</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MessageID</td>
                <td>@item.SenderName</td>
                <td>@item.SenderSubject</td>
                <td>@item.SendDate.ToString("dd MMM yyyy")</td>
                <td><a href="/Admin/Message/MessageDetail/@item.MessageID" class="btn btn-info">Mesaji Ac</a></td>
                <td><a href="/Admin/Message/UpdateMessage/@item.MessageID" class="btn btn-success">Mesaji Duzenle</a></td>
                <td><a href="/Admin/Message/DeleteMessage/@item.MessageID" class="btn btn-danger">Mesaji Sil</a></td>
            </tr>
        }
    </table>
</div>