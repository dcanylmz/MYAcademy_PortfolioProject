@model Project
@{
    ViewData["Title"] = "Projeyi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    ViewData["FormAction"] = "UpdateProject";
    ViewData["FormTitle"] = "Projeyi Güncelle";
    ViewData["FormSubtitle"] = $"#{Model.ProjectID} numaralı projenin bilgilerini düzenleyin. Yeni görsel seçmezseniz mevcut görsel korunur.";
    ViewData["SubmitText"] = "Değişiklikleri Kaydet";
}
<partial name="_AdminFormStyles" />

<div class="af container-fluid py-3">
    <partial name="_ProjectForm" model="Model" />
</div>
