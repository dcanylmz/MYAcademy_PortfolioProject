@model List<HeroTitle>
@{
    ViewData["Title"] = "Yazı Animasyonu";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<partial name="_AdminFormStyles" />

<div class="af container-fluid py-3">
    <div class="af-card">
        <div class="af-head">
            <div class="af-icon"><i class="bi bi-type"></i></div>
            <div>
                <h4>Yazı Animasyonu Unvanları</h4>
                <small>Ana sayfada sırayla yazılıp silinen unvanlar. Sıra numarası küçük olan önce gösterilir.</small>
            </div>
        </div>

        <form asp-action="CreateHeroTitle" method="post" class="row g-2 mb-4">
            <div class="col-md-7">
                <input name="Title" class="form-control" placeholder="Yeni unvan (ör. .NET Eğitmeni)" maxlength="100" />
            </div>
            <div class="col-md-2">
                <input name="Order" type="number" min="1" max="100" value="@(Model.Count + 1)" class="form-control" title="Sıra" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="af-btn w-100"><i class="bi bi-plus-lg me-1"></i> Ekle</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table af-table align-middle mb-0">
                <thead>
                    <tr><th style="width:80px">Sıra</th><th>Unvan</th><th>Durum</th><th class="text-end">İşlemler</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Order</td>
                            <td class="fw-semibold">@item.Title</td>
                            <td><span class="af-badge @(item.IsActive ? "on" : "off")">@(item.IsActive ? "Aktif" : "Pasif")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="UpdateHeroTitle" asp-route-id="@item.HeroTitleID" class="af-icon-btn" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DeleteHeroTitle" asp-route-id="@item.HeroTitleID" method="post" class="d-inline">
                                    <button type="button" class="af-icon-btn danger js-delete" data-name="@item.Title" title="Sil"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-5">Henüz unvan eklenmedi. Boş bırakılırsa sitede varsayılan bir unvan gösterilir.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3"><a asp-controller="Hero" asp-action="Index" class="af-btn-light">&larr; Ana Sayfa Alanına Dön</a></div>
    </div>
</div>

<partial name="_AdminAlerts" />
